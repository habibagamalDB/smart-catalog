# Copy to .env.local and fill in. Never commit real values.

# Public (shipped to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) from `npm run supabase -- status` or the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never prefix with NEXT_PUBLIC_)
# Secret key (sb_secret_...). Bypasses RLS; used only by server code in src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
